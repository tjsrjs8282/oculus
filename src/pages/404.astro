---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Button from '@/components/Button.astro';
import { url } from '@/lib/url';
---

<BaseLayout title="페이지를 찾을 수 없어요" noindex>
  <section class="nf" aria-labelledby="nf-title">
    <div class="container nf__inner">
      <p class="nf__code" aria-hidden="true">
        404
      </p>
      <h1 id="nf-title">이 공간은 아직 스캔되지 않았어요</h1>
      <p class="lead">
        주소가 바뀌었거나 없는 페이지예요. 경계를 다시 그리고 홈으로 돌아가 볼까요?
      </p>
      <div class="nf__actions">
        <Button href={url()} variant="primary" icon="arrow-right">
          홈으로
        </Button>
        <Button href={url('games.html')}>게임 둘러보기</Button>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .nf {
    display: grid;
    place-items: center;
    min-block-size: 80svh;
    padding-block: calc(var(--header-h) + 3rem) 3rem;
    background:
      radial-gradient(40% 40% at 50% 40%, rgb(139 92 255 / 0.18), transparent 70%),
      radial-gradient(30% 30% at 60% 60%, rgb(79 140 255 / 0.14), transparent 70%);
  }

  .nf__inner {
    display: grid;
    justify-items: center;
    gap: 1.25rem;
    text-align: center;
  }

  .nf__code {
    font-size: clamp(6rem, 3rem + 14vw, 13rem);
    font-weight: 900;
    line-height: 0.9;
    letter-spacing: -0.06em;
    background: var(--grad-brand);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  h1 {
    font-size: var(--fs-2xl);
    font-weight: 800;
  }

  .nf__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-block-start: 0.5rem;
  }
</style>
