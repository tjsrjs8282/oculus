---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Button from '@/components/Button.astro';
import CtaBand from '@/components/CtaBand.astro';
import Icon from '@/components/Icon.astro';
import Img from '@/components/Img.astro';
import PageHero from '@/components/PageHero.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import { products } from '@/data/products';
import { official } from '@/data/site';
import { milestones } from '@/data/timeline';
import type { IconName } from '@/lib/icons';
import { url } from '@/lib/url';
import aboutHero from '@/assets/gen/about-hero.jpg';
import glasses from '@/assets/gen/glasses-teaser.jpg';

const reasons: { icon: IconName; title: string; text: string }[] = [
  {
    icon: 'headset',
    title: '선 없는 자유',
    text: 'PC도 외부 센서도 필요 없는 올인원 헤드셋. 켜면 바로 시작해요.',
  },
  {
    icon: 'layers',
    title: '현실과 함께',
    text: '풀 컬러 혼합현실로 주변을 보면서 가상 콘텐츠를 즐겨요.',
  },
  {
    icon: 'gamepad',
    title: '가장 큰 라이브러리',
    text: '게임, 피트니스, 영상, 소셜까지 수천 개의 앱이 기다려요.',
  },
  {
    icon: 'monitor',
    title: 'PC VR까지',
    text: '케이블 하나, 혹은 무선으로 고사양 PC VR 게임도 즐겨요.',
  },
];

const devTools: { icon: IconName; title: string; text: string }[] = [
  {
    icon: 'code',
    title: 'Meta XR SDK',
    text: 'Unity와 Unreal용 공식 SDK. 핸드 트래킹, 패스스루, 공간 앵커까지 한 번에.',
  },
  {
    icon: 'smartphone',
    title: 'Meta Spatial SDK',
    text: 'Android 개발자가 익숙한 도구 그대로 혼합현실 앱을 만들 수 있어요.',
  },
  {
    icon: 'globe',
    title: 'WebXR',
    text: '설치 없이 브라우저에서 바로 실행되는 웹 기반 VR·MR 경험.',
  },
  {
    icon: 'sparkles',
    title: 'Meta Horizon OS',
    text: 'Quest를 움직이는 Android 기반 운영체제와 Meta Horizon Store.',
  },
];

// 지금 살 수 있는 두 모델 + 다음 제품
const lineup = [
  ...products.map((p) => ({
    status: p.id === 'quest-3' ? '플래그십' : '입문형',
    title: p.name,
    text: p.summary,
    image: p.image,
    alt: p.imageAlt,
    product: true,
    href: url(`quest.html#${p.id}`),
    video: p.video,
  })),
  {
    status: '2027년 봄 출시 예정',
    title: 'Meta VR Glasses',
    text: '연산은 컴퓨팅 퍽이 맡고, 얼굴에는 안경처럼 가볍게. 손과 시선만으로 조작하는 차세대 VR 글래스예요. 발표가 $1,299.99.',
    image: glasses,
    alt: '어둠 속에서 빛의 선으로 그려진 가벼운 고글 실루엣',
    product: false,
    href: `${url()}#vr-glasses`,
    video: undefined,
  },
];
---

<BaseLayout
  title="소개"
  description="Meta Quest 3·3S와 Meta Horizon OS, 2027년 Meta VR Glasses까지. 지금의 Meta Quest를 한눈에."
  ogImage={aboutHero}
>
  <PageHero
    image={aboutHero}
    eyebrow="About Meta Quest"
    title={'현실과 가상을\n*하나로* 잇다'}
    lead="Meta Quest는 풀 컬러 혼합현실 헤드셋과 Meta Horizon OS, 수천 개의 앱이 하나로 연결된 플랫폼이에요. 다음 무대는 안경처럼 가벼운 VR 글래스예요."
  >
    <Button slot="actions" href="#lineup" variant="primary" icon="arrow-right">
      라인업 보기
    </Button>
  </PageHero>

  <!-- ============ why ============ -->
  <section class="section" aria-labelledby="why-title">
    <div class="container">
      <SectionHeading id="why-title" eyebrow="Why Quest" title="왜 *Meta Quest*인가요?" />
      <ul class="cards" role="list">
        {reasons.map((reason, i) => (
          <li class="card" data-reveal style={{ '--i': i }}>
            <span class="card__icon">
              <Icon name={reason.icon} />
            </span>
            <h3>{reason.title}</h3>
            <p>{reason.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ============ now & next ============ -->
  <section id="lineup" class="section" aria-labelledby="lineup-title">
    <div class="container">
      <SectionHeading
        id="lineup-title"
        eyebrow="Now & Next"
        title="지금, 그리고 *다음*"
        lead="지금 만날 수 있는 Quest 3와 3S, 그리고 2027년에 나올 Meta VR Glasses."
      />
      <ul class="lineup" role="list">
        {lineup.map((item, i) => (
          <li
            class:list={[
              'lineup-card',
              item.product ? 'lineup-card--product' : 'lineup-card--next',
            ]}
            data-reveal
            style={{ '--i': i }}
          >
            <div class="lineup-card__media">
              <Img
                src={item.image}
                alt={item.alt}
                widths={[360, 540, 720, 960]}
                sizes="(min-width: 1000px) 30vw, 90vw"
                fit={item.product ? 'contain' : 'cover'}
              />
            </div>
            <div class="lineup-card__body">
              <span class:list={['badge', item.product ? 'badge--blue' : 'badge--amber']}>
                {item.status}
              </span>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
              <div class="lineup-card__actions">
                <a class="link-arrow" href={item.href}>
                  자세히 보기 <Icon name="arrow-right" size={16} />
                </a>
                {item.video && (
                  <button
                    type="button"
                    class="link-arrow"
                    data-video={item.video.id}
                    data-video-title={item.video.title}
                  >
                    영상 보기 <Icon name="play" size={14} />
                  </button>
                )}
              </div>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ============ milestones ============ -->
  <section id="milestones" class="section" aria-labelledby="ms-title">
    <div class="container container--narrow">
      <SectionHeading
        id="ms-title"
        eyebrow="Milestones"
        title="최근 주요 발표"
        lead="Meta Quest의 최근 소식부터 순서대로 정리했어요."
      />
      <div class="ms">
        <span class="ms__fill" aria-hidden="true"></span>
        <ol class="ms__list" role="list">
          {milestones.map((m, i) => (
            <li class:list={['ms__item', i === 0 && 'ms__item--latest']} data-reveal>
              <span class="ms__dot" aria-hidden="true" />
              <time class="ms__date" datetime={m.iso}>
                {m.date}
              </time>
              <div class="ms__body">
                <h3>{m.title}</h3>
                <p>{m.text}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <!-- ============ developers ============ -->
  <section class="section" aria-labelledby="dev-title">
    <div class="container">
      <SectionHeading
        id="dev-title"
        eyebrow="For developers"
        title="만들 준비가 되셨나요?"
        lead="Unity·Unreal용 Meta XR SDK부터 Android 개발자를 위한 Spatial SDK, 웹 기반 WebXR까지. Meta Horizon 플랫폼에서 바로 시작할 수 있어요."
      />
      <ul class="cards" role="list">
        {devTools.map((tool, i) => (
          <li class="card" data-reveal style={{ '--i': i }}>
            <span class="card__icon card__icon--dev">
              <Icon name={tool.icon} />
            </span>
            <h3>{tool.title}</h3>
            <p>{tool.text}</p>
          </li>
        ))}
      </ul>
      <div class="dev__foot">
        <Button href={official.developers} variant="primary" icon="arrow-up-right">
          Meta Horizon 개발자 센터
        </Button>
      </div>
    </div>
  </section>

  <CtaBand
    eyebrow="Your turn"
    title="이제, 직접 경험해 볼 차례"
    text="Meta Quest 3·3S로 지금 바로 혼합현실을 시작해 보세요."
  >
    <Button href={url('quest.html')} variant="primary" size="lg" icon="arrow-right">
      Meta Quest 3·3S
    </Button>
    <Button href={url('games.html')} size="lg" icon="arrow-right">
      게임 둘러보기
    </Button>
  </CtaBand>
</BaseLayout>

<style>
  /* ---------- cards ---------- */
  .cards {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
  }

  .card {
    display: grid;
    align-content: start;
    gap: 0.7rem;
    padding: 1.75rem;
    border: 1px solid var(--c-border);
    border-radius: var(--r-lg);
    background: var(--c-surface);
  }

  .card__icon {
    display: grid;
    place-items: center;
    inline-size: 48px;
    block-size: 48px;
    margin-block-end: 0.4rem;
    border-radius: 14px;
    background: linear-gradient(135deg, rgb(79 140 255 / 0.25), rgb(139 92 255 / 0.25));
    color: #cfe0ff;
  }

  .card__icon--dev {
    background: linear-gradient(135deg, rgb(52 214 255 / 0.22), rgb(61 220 151 / 0.2));
    color: #c9f6ff;
  }

  .card h3 {
    font-size: var(--fs-lg);
  }

  .card p {
    font-size: var(--fs-sm);
    color: var(--c-text-2);
  }

  @media (max-width: 1000px) {
    .cards {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 560px) {
    .cards {
      grid-template-columns: 1fr;
    }
  }

  /* ---------- now & next ---------- */
  .lineup {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
  }

  .lineup-card {
    display: grid;
    grid-template-rows: auto 1fr;
    border: 1px solid var(--c-border);
    border-radius: var(--r-xl);
    background: linear-gradient(180deg, rgb(255 255 255 / 0.05), rgb(255 255 255 / 0.015));
    overflow: hidden;
  }

  .lineup-card--next {
    border-color: rgb(255 184 77 / 0.3);
  }

  .lineup-card__media {
    position: relative;
    display: grid;
    place-items: center;
    aspect-ratio: 4 / 3;
    overflow: hidden;
  }

  .lineup-card--product .lineup-card__media {
    background: radial-gradient(closest-side, rgb(79 140 255 / 0.28), transparent);
  }

  .lineup-card--product .lineup-card__media :global(img) {
    inline-size: 78%;
    block-size: auto;
    filter: drop-shadow(0 22px 30px rgb(0 0 0 / 0.5));
    transition: scale 0.8s var(--ease-out);
  }

  .lineup-card--product:hover .lineup-card__media :global(img) {
    scale: 1.05;
  }

  .lineup-card--next .lineup-card__media :global(img) {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
  }

  .lineup-card__body {
    display: grid;
    align-content: start;
    justify-items: start;
    gap: 0.7rem;
    padding: 1.5rem 1.75rem 1.75rem;
  }

  .lineup-card__body h3 {
    font-size: var(--fs-xl);
    font-weight: 800;
  }

  .lineup-card__body p {
    font-size: var(--fs-sm);
    color: var(--c-text-2);
  }

  .lineup-card__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    margin-block-start: 0.4rem;
    font-size: var(--fs-sm);
  }

  @media (max-width: 1000px) {
    .lineup {
      grid-template-columns: 1fr;
      max-inline-size: 34rem;
      margin-inline: auto;
    }
  }

  /* ---------- milestones ---------- */
  .ms {
    position: relative;
    padding-inline-start: 2.25rem;
  }

  .ms::before,
  .ms__fill {
    content: '';
    position: absolute;
    top: 0.6rem;
    bottom: 0.6rem;
    left: 6px;
    inline-size: 2px;
    border-radius: 1px;
  }

  .ms::before {
    background: var(--c-border);
  }

  .ms__fill {
    background: linear-gradient(180deg, var(--c-pink), var(--c-violet), var(--c-blue));
    transform-origin: top;
  }

  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .ms__fill {
        animation: ms-fill linear both;
        animation-timeline: view();
        /* 채워진 선의 끝이 화면 중앙을 따라온다 */
        animation-range: cover 50vh cover calc(100% - 50vh);
      }
    }
  }

  @keyframes ms-fill {
    from {
      scale: 1 0;
    }
    to {
      scale: 1 1;
    }
  }

  .ms__list {
    display: grid;
    gap: 0.75rem;
  }

  .ms__item {
    position: relative;
    display: grid;
    grid-template-columns: 6.5rem 1fr;
    gap: 1.25rem;
    padding: 1.25rem 1.5rem;
    border: 1px solid var(--c-border);
    border-radius: var(--r-lg);
    background: var(--c-surface);
  }

  .ms__item--latest {
    border-color: rgb(79 140 255 / 0.4);
    background: linear-gradient(160deg, rgb(79 140 255 / 0.12), rgb(255 255 255 / 0.02));
  }

  .ms__dot {
    position: absolute;
    top: 1.65rem;
    left: calc(-2.25rem + 7px);
    inline-size: 12px;
    block-size: 12px;
    translate: -50% 0;
    border: 2px solid var(--c-bg);
    border-radius: 50%;
    background: var(--c-text-3);
  }

  .ms__item--latest .ms__dot {
    background: var(--c-blue);
    box-shadow: 0 0 14px var(--c-blue);
  }

  .ms__date {
    font-size: var(--fs-lg);
    font-weight: 800;
    letter-spacing: -0.03em;
    font-variant-numeric: tabular-nums;
    background: var(--grad-brand);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .ms__body {
    display: grid;
    gap: 0.3rem;
  }

  .ms__body h3 {
    font-size: var(--fs-md);
  }

  .ms__body p {
    font-size: var(--fs-sm);
    color: var(--c-text-2);
  }

  @media (max-width: 560px) {
    .ms__item {
      grid-template-columns: 1fr;
      gap: 0.35rem;
    }
  }

  .dev__foot {
    margin-block-start: 2rem;
  }
</style>
