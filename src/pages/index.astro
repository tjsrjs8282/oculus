---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Button from '@/components/Button.astro';
import GameCard from '@/components/GameCard.astro';
import Icon from '@/components/Icon.astro';
import Img from '@/components/Img.astro';
import ProductCard from '@/components/ProductCard.astro';
import Rail from '@/components/Rail.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import { featuredGames } from '@/data/games';
import { news } from '@/data/news';
import { priceNote, products } from '@/data/products';
import { url } from '@/lib/url';
import heroImage from '@/assets/gen/hero-home.jpg';
import gaming from '@/assets/gen/gaming.jpg';
import fitness from '@/assets/gen/fitness.jpg';
import mixedReality from '@/assets/gen/mixed-reality.jpg';
import cinema from '@/assets/gen/cinema.jpg';
import social from '@/assets/gen/social.jpg';
import productivity from '@/assets/gen/productivity.jpg';
import glasses from '@/assets/gen/glasses-teaser.jpg';
import setupImage from '@/assets/gen/setup.jpg';
import pcvrImage from '@/assets/gen/pc-vr.jpg';

const experiences = [
  {
    id: 'gaming',
    image: gaming,
    alt: '네온 조명 속에서 컨트롤러를 겨누며 몸을 피하는 게이머',
    label: '게임',
    title: '손에 쥐는 액션',
    text: '검을 휘두르고, 총을 겨누고, 몸을 숙여 피하세요. 수천 개의 게임이 기다려요.',
    href: url('games.html'),
  },
  {
    id: 'fitness',
    image: fitness,
    alt: '헤드셋을 쓰고 가상 타깃을 향해 펀치를 날리는 사람',
    label: '피트니스',
    title: '운동이 게임이 되는 순간',
    text: '복싱, 댄스, 리듬 운동으로 거실에서 땀 흘리는 재미.',
  },
  {
    id: 'mixed-reality',
    image: mixedReality,
    alt: '거실 탁자 위에 가상의 성과 용을 띄워 놓고 노는 사람',
    label: '혼합현실',
    title: '내 방이 게임 무대로',
    text: '풀 컬러 패스스루로 현실 위에 성과 용, 보드게임을 올려 보세요.',
  },
  {
    id: 'cinema',
    image: cinema,
    alt: '소파에 앉아 허공에 뜬 거대한 오로라 화면을 보는 사람',
    label: '엔터테인먼트',
    title: '나만의 초대형 스크린',
    text: '영화, 스포츠, 라이브 공연을 눈앞의 거대한 화면으로.',
  },
  {
    id: 'social',
    image: social,
    alt: '헤드셋을 쓴 두 친구가 웃으며 하이파이브하는 모습',
    label: '소셜',
    title: '떨어져 있어도 함께',
    text: '친구와 같은 공간에서 웃고 떠들고 플레이하세요.',
  },
  {
    id: 'productivity',
    image: productivity,
    alt: '책상 앞 허공에 가상 모니터 세 개를 띄우고 일하는 사람',
    label: '생산성',
    title: '어디서나 멀티 모니터',
    text: '가상 모니터를 띄워 나만의 집중 공간을 만들어요.',
  },
];

const stats = [
  { value: 2064, suffix: '×2208', label: '한쪽 눈 해상도', note: '4K+ Infinite Display' },
  { value: 110, suffix: '°', label: '수평 시야각', note: '팬케이크 렌즈' },
  { value: 120, suffix: 'Hz', label: '최대 주사율', note: '부드러운 움직임' },
  { value: 10, suffix: '배', label: '패스스루 픽셀', note: 'Quest 2 대비' },
];
---

<BaseLayout>
  <!-- ============ HERO ============ -->
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero__media">
      <Img
        src={heroImage}
        alt=""
        layout="full-width"
        priority
        widths={[768, 1280, 1600, 1920, 2560]}
        sizes="100vw"
      />
      <video
        class="hero__video"
        muted
        loop
        playsinline
        preload="none"
        aria-hidden="true"
        tabindex="-1"
        data-hero-video
        data-webm={url('media/hero-loop.webm')}
        data-mp4={url('media/hero-loop.mp4')}
      ></video>
    </div>
    <div class="hero__shade" aria-hidden="true"></div>

    <div class="container hero__content">
      <a class="hero__news" href="#vr-glasses">
        <span class="badge badge--blue">NEW</span>
        Connect 2026 · Meta VR Glasses 공개
        <Icon name="arrow-right" size={16} />
      </a>
      <p class="eyebrow">Meta Quest 3 · 3S</p>
      <h1 id="hero-title" class="hero__title">
        현실 위에
        <br />
        <span class="text-gradient">새로운 세계</span>를 펼치다
      </h1>
      <p class="hero__lead lead">
        Oculus에서 Meta Quest로. 풀 컬러 혼합현실로 거실이 게임 무대가 되고, 수천 개의 앱과 게임이
        손끝에서 시작돼요.
      </p>
      <div class="hero__actions">
        <Button href={url('quest.html')} variant="primary" size="lg" icon="arrow-right">
          제품 살펴보기
        </Button>
        <Button video="Exu7r2vZpcw" videoTitle="This is Meta Quest 3" size="lg" iconStart="play">
          영상 보기
        </Button>
      </div>
    </div>

    <button class="hero__motion" type="button" aria-pressed="false" hidden data-hero-toggle>
      <span class="sr-only">배경 영상 일시정지</span>
      <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">
        <path
          class="i-pause"
          d="M8 5v14M16 5v14"
          stroke="currentColor"
          stroke-width="2.4"
          stroke-linecap="round"
        ></path>
        <path class="i-play" d="M8 5.5v13l10-6.5z" fill="currentColor"></path>
      </svg>
    </button>
    <a class="hero__scroll" href="#lineup" aria-label="제품 라인업으로 이동">
      <span></span>
    </a>
  </section>

  <!-- ============ LINEUP ============ -->
  <section id="lineup" class="section lineup" aria-labelledby="lineup-title">
    <div class="container">
      <SectionHeading
        id="lineup-title"
        eyebrow="Lineup 2026"
        title="나에게 맞는 *Meta Quest*"
        lead="같은 칩셋, 같은 게임 라이브러리. 더 선명한 화면을 원한다면 Quest 3, 합리적으로 시작하고 싶다면 Quest 3S."
        align="center"
      />
      <div class="lineup__grid">
        {products.map((product, i) => (
          <ProductCard product={product} index={i} />
        ))}
      </div>
      <p class="lineup__note fine">
        {priceNote}
        <a class="link-arrow" href={url('quest.html#compare')}>
          스펙 자세히 비교하기 <Icon name="arrow-right" size={16} />
        </a>
      </p>
    </div>
  </section>

  <!-- ============ EXPERIENCES (bento) ============ -->
  <section class="section experiences" aria-labelledby="exp-title">
    <div class="container">
      <SectionHeading
        id="exp-title"
        eyebrow="Experiences"
        title={'Quest로 할 수 있는\n*모든 것*'}
        lead="게임에서 운동, 영화, 일까지. 헤드셋 하나로 매일의 경험이 넓어져요."
      />
      <ul class="bento" role="list">
        {experiences.map((item, i) => (
          <li class:list={['tile', `tile--${item.id}`]} data-reveal style={{ '--i': i % 3 }}>
            <div class="tile__media">
              <Img
                src={item.image}
                alt={item.alt}
                widths={[480, 720, 960, 1280, 1600]}
                sizes={
                  i === 0 ? '(min-width: 1000px) 66vw, 100vw' : '(min-width: 1000px) 34vw, 100vw'
                }
              />
            </div>
            <div class="tile__body">
              <p class="tile__label">{item.label}</p>
              <h3 class="tile__title">{item.title}</h3>
              <p class="tile__text">{item.text}</p>
              {item.href && (
                <a class="link-arrow tile__link" href={item.href}>
                  게임 둘러보기 <Icon name="arrow-right" size={16} />
                </a>
              )}
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ============ STATS ============ -->
  <section class="section--tight stats" aria-labelledby="stats-title">
    <div class="container">
      <h2 id="stats-title" class="sr-only">
        숫자로 보는 Meta Quest 3
      </h2>
      <dl class="stats__grid">
        {stats.map((stat, i) => (
          <div class="stat" data-reveal style={{ '--i': i }}>
            <dt class="stat__label">{stat.label}</dt>
            <dd class="stat__value">
              <span data-count={stat.value}>{stat.value}</span>
              {stat.suffix}
            </dd>
            <dd class="stat__note">{stat.note}</dd>
          </div>
        ))}
      </dl>
      <p class="fine stats__foot">Meta Quest 3 기준 · 패스스루 픽셀은 Meta 발표 수치</p>
    </div>
  </section>

  <!-- ============ GAMES ============ -->
  <section class="section games-preview" aria-labelledby="games-title">
    <div class="container">
      <Rail label="추천 게임">
        <div slot="head" class="games-preview__head">
          <p class="eyebrow">Games</p>
          <h2 id="games-title">지금 플레이할 게임</h2>
          <a class="link-arrow" href={url('games.html')}>
            게임 전체 보기 <Icon name="arrow-right" size={16} />
          </a>
        </div>
        {featuredGames.slice(0, 8).map((game) => (
          <GameCard game={game} />
        ))}
      </Rail>
    </div>
  </section>

  <!-- ============ META VR GLASSES TEASER ============ -->
  <section id="vr-glasses" class="teaser" aria-labelledby="teaser-title">
    <div class="teaser__media" aria-hidden="true">
      <Img
        src={glasses}
        alt=""
        layout="full-width"
        widths={[960, 1440, 1920, 2400]}
        sizes="100vw"
      />
    </div>
    <div class="container teaser__content">
      <div class="teaser__copy" data-reveal>
        <p class="eyebrow">Coming 2027</p>
        <h2 id="teaser-title">Meta VR Glasses</h2>
        <p class="lead">
          Connect 2026에서 공개된 Meta의 차세대 VR 글래스. 연산은 주머니 속 퍽에 맡기고, 얼굴에는
          안경처럼 가볍게.
        </p>
      </div>
      <dl class="teaser__facts" data-reveal style={{ '--i': 1 }}>
        <div>
          <dt>출시</dt>
          <dd>2027년 봄 예정</dd>
        </div>
        <div>
          <dt>발표가</dt>
          <dd>$1,299.99</dd>
        </div>
        <div>
          <dt>조작</dt>
          <dd>핸드 · 시선 추적</dd>
        </div>
        <div>
          <dt>인터페이스</dt>
          <dd>AI 중심 OS</dd>
        </div>
      </dl>
      <p class="fine teaser__note">
        Connect 2026 발표 내용 기준이에요. 사양과 일정은 바뀔 수 있어요.
      </p>
    </div>
  </section>

  <!-- ============ NEWS ============ -->
  <section class="section news" aria-labelledby="news-title">
    <div class="container">
      <SectionHeading id="news-title" eyebrow="Newsroom" title="Oculus *새 소식*" />
      <ul class="news__grid" role="list">
        {news.map((item, i) => (
          <li class="news-card" data-reveal style={{ '--i': i }}>
            <div class="news-card__meta">
              <span class="badge">{item.tag}</span>
              <time datetime={item.iso}>{item.date}</time>
            </div>
            <h3 class="news-card__title">{item.title}</h3>
            <p class="news-card__summary">{item.summary}</p>
            <a
              class="news-card__source"
              href={item.source.url}
              target="_blank"
              rel="noopener noreferrer"
            >
              출처 · {item.source.name}
              <span class="sr-only">(새 창)</span>
              <Icon name="arrow-up-right" size={15} />
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ============ GUIDES ============ -->
  <section class="guides" aria-labelledby="guides-title">
    <div class="container">
      <h2 id="guides-title" class="sr-only">
        가이드
      </h2>
      <div class="guides__grid">
        <a class="guide" href={url('setup.html')} data-reveal>
          <div class="guide__media">
            <Img
              src={setupImage}
              alt=""
              widths={[480, 720, 960, 1280]}
              sizes="(min-width: 860px) 50vw, 100vw"
            />
          </div>
          <div class="guide__body">
            <p class="eyebrow">Getting started</p>
            <h3>처음이라면, 설정 가이드</h3>
            <p>충전부터 공간 설정까지 7단계면 끝. 체크리스트로 따라 해 보세요.</p>
            <span class="link-arrow">
              가이드 보기 <Icon name="arrow-right" size={16} />
            </span>
          </div>
        </a>
        <a class="guide" href={url('pc-vr.html')} data-reveal style={{ '--i': 1 }}>
          <div class="guide__media">
            <Img
              src={pcvrImage}
              alt=""
              widths={[480, 720, 960, 1280]}
              sizes="(min-width: 860px) 50vw, 100vw"
            />
          </div>
          <div class="guide__body">
            <p class="eyebrow">PC VR</p>
            <h3>PC 게임까지, 선 하나로</h3>
            <p>
              Quest Link · Air Link · Steam Link로 고사양 PC VR까지. 내 그래픽카드 호환성도 바로
              확인해요.
            </p>
            <span class="link-arrow">
              연결 방법 보기 <Icon name="arrow-right" size={16} />
            </span>
          </div>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  /* 히어로 배경 영상: 넓은 화면 + 동작 줄이기 꺼짐 + 데이터 절약 꺼짐일 때만 받는다. */
  const video = document.querySelector<HTMLVideoElement>('[data-hero-video]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-hero-toggle]');
  const connection = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection;
  const allowed =
    window.matchMedia('(min-width: 768px) and (prefers-reduced-motion: no-preference)').matches &&
    !connection?.saveData;

  if (video && toggle && allowed) {
    let userPaused = false;
    for (const [type, key] of [
      ['video/webm', 'webm'],
      ['video/mp4', 'mp4'],
    ] as const) {
      const src = video.dataset[key];
      if (!src) continue;
      const source = document.createElement('source');
      source.src = src;
      source.type = type;
      video.append(source);
    }
    video.addEventListener(
      'playing',
      () => {
        video.classList.add('is-playing');
        toggle.hidden = false;
      },
      { once: true },
    );
    video.load();
    video.play().catch(() => {});

    const label = toggle.querySelector('.sr-only');
    toggle.addEventListener('click', () => {
      userPaused = !video.paused;
      if (userPaused) video.pause();
      else video.play().catch(() => {});
      toggle.setAttribute('aria-pressed', String(userPaused));
      if (label) label.textContent = userPaused ? '배경 영상 재생' : '배경 영상 일시정지';
    });

    // 화면 밖에서는 멈춰서 CPU·배터리를 아낀다
    new IntersectionObserver(([entry]) => {
      if (!entry || userPaused) return;
      if (entry.isIntersecting) video.play().catch(() => {});
      else video.pause();
    }).observe(video);
  }
</script>

<style>
  /* ---------- hero ---------- */
  .hero {
    position: relative;
    isolation: isolate;
    display: grid;
    align-items: center;
    min-block-size: max(100svh, 40rem);
    padding-block: calc(var(--header-h) + 3rem) 7rem;
    overflow: hidden;
  }

  .hero__media {
    position: absolute;
    inset: 0;
    z-index: -2;
  }

  .hero__media :global(img),
  .hero__video {
    position: absolute;
    inset: 0;
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    object-position: 72% 50%;
  }

  .hero__video {
    opacity: 0;
    transition: opacity 1.4s var(--ease-out);
  }

  .hero__video.is-playing {
    opacity: 1;
  }

  .hero__shade {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(90deg, rgb(5 5 7 / 0.9) 0%, rgb(5 5 7 / 0.55) 34%, rgb(5 5 7 / 0) 64%),
      linear-gradient(0deg, var(--c-bg) 0%, rgb(5 5 7 / 0) 32%);
  }

  @supports (animation-timeline: scroll()) {
    @media (prefers-reduced-motion: no-preference) {
      .hero__media {
        animation: hero-drift linear both;
        animation-timeline: scroll(root);
        animation-range: 0 100vh;
      }

      .hero__content {
        animation: hero-fade linear both;
        animation-timeline: scroll(root);
        animation-range: 0 70vh;
      }
    }
  }

  @keyframes hero-drift {
    to {
      transform: translateY(16%) scale(1.06);
    }
  }

  @keyframes hero-fade {
    to {
      opacity: 0;
      transform: translateY(-6%);
    }
  }

  .hero__content {
    display: grid;
    justify-items: start;
    gap: 1.25rem;
  }

  .hero__news {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin-block-end: 0.5rem;
    padding: 0.35rem 0.85rem 0.35rem 0.35rem;
    border: 1px solid var(--c-border-2);
    border-radius: var(--r-pill);
    background: rgb(255 255 255 / 0.06);
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
    font-size: var(--fs-xs);
    font-weight: 500;
    transition:
      background-color 0.3s,
      border-color 0.3s;
  }

  .hero__news:hover {
    background: rgb(255 255 255 / 0.12);
    border-color: rgb(255 255 255 / 0.32);
  }

  .hero__title {
    font-size: var(--fs-hero);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.05em;
  }

  .hero__lead {
    max-inline-size: 34rem;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-block-start: 0.75rem;
  }

  .hero__motion {
    position: absolute;
    right: var(--gutter);
    bottom: 2rem;
    display: grid;
    place-items: center;
    inline-size: 44px;
    block-size: 44px;
    border: 1px solid var(--c-border-2);
    border-radius: 50%;
    background: rgb(0 0 0 / 0.35);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    color: #fff;
  }

  .hero__motion[hidden] {
    display: none;
  }

  .hero__motion .i-play,
  .hero__motion[aria-pressed='true'] .i-pause {
    display: none;
  }

  .hero__motion[aria-pressed='true'] .i-play {
    display: block;
  }

  .hero__scroll {
    position: absolute;
    left: 50%;
    bottom: 2rem;
    translate: -50% 0;
    display: grid;
    place-items: center;
    inline-size: 28px;
    block-size: 46px;
    border: 1.5px solid rgb(255 255 255 / 0.4);
    border-radius: var(--r-pill);
  }

  .hero__scroll span {
    inline-size: 4px;
    block-size: 8px;
    border-radius: 2px;
    background: #fff;
    animation: scroll-cue 2s var(--ease-in-out) infinite;
  }

  @keyframes scroll-cue {
    0% {
      opacity: 0;
      translate: 0 -8px;
    }
    40% {
      opacity: 1;
    }
    100% {
      opacity: 0;
      translate: 0 10px;
    }
  }

  @media (max-width: 767px) {
    .hero {
      align-items: end;
      min-block-size: max(100svh, 42rem);
      padding-block-end: 4rem;
    }

    .hero__media :global(img) {
      object-position: 78% 50%;
    }

    .hero__shade {
      background: linear-gradient(
        0deg,
        var(--c-bg) 0%,
        rgb(5 5 7 / 0.9) 36%,
        rgb(5 5 7 / 0.35) 62%,
        rgb(5 5 7 / 0.1) 100%
      );
    }

    .hero__scroll {
      display: none;
    }
  }

  /* 작은 화면: 인물 얼굴을 가리지 않도록 보조 요소를 줄인다 */
  @media (max-width: 480px) {
    .hero__news {
      display: none;
    }

    .hero__actions :global(.btn) {
      min-block-size: 50px;
      padding-inline: 1.2em;
      font-size: var(--fs-sm);
    }
  }

  /* ---------- lineup ---------- */
