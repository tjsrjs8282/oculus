---
/**
 * 가로 스크롤 레일 — bxSlider/Swiper 대신 CSS scroll-snap + 버튼 몇 줄.
 * 터치·트랙패드·키보드(←/→, 포커스 후) 모두 브라우저 기본 스크롤로 동작한다.
 */
import Icon from './Icon.astro';

interface Props {
  label: string;
  /** 카드 한 장의 너비 */
  item?: string;
  class?: string;
}

const { label, item = 'min(320px, 78vw)', class: className } = Astro.props;
---

<div class:list={['rail', className]} data-rail style={{ '--rail-item': item }}>
  <div class="rail__head">
    <slot name="head" />
    <div class="rail__controls">
      <button type="button" class="rail__btn" data-rail-prev disabled>
        <Icon name="chevron-left" size={20} />
        <span class="sr-only">{label} 이전</span>
      </button>
      <button type="button" class="rail__btn" data-rail-next>
        <Icon name="chevron-right" size={20} />
        <span class="sr-only">{label} 다음</span>
      </button>
    </div>
  </div>
  <ul class="rail__track" role="list" aria-label={label} tabindex="0" data-rail-track>
    <slot />
  </ul>
</div>

<script>
  for (const rail of document.querySelectorAll<HTMLElement>('[data-rail]')) {
    const track = rail.querySelector<HTMLElement>('[data-rail-track]');
    const prev = rail.querySelector<HTMLButtonElement>('[data-rail-prev]');
    const next = rail.querySelector<HTMLButtonElement>('[data-rail-next]');
    if (!track || !prev || !next) continue;

    const sync = () => {
      const max = track.scrollWidth - track.clientWidth - 2;
      prev.disabled = track.scrollLeft <= 2;
      next.disabled = track.scrollLeft >= max;
    };
    const page = (dir: 1 | -1) =>
      track.scrollBy({ left: dir * track.clientWidth * 0.85, behavior: 'smooth' });

    prev.addEventListener('click', () => page(-1));
    next.addEventListener('click', () => page(1));
    track.addEventListener('scroll', sync, { passive: true });
    new ResizeObserver(sync).observe(track);
    sync();
  }
</script>

<style>
  /* grid·flex 안에 들어가도 카드 총폭만큼 늘어나지 않게 (grid blowout 방지) */
  .rail {
    min-inline-size: 0;
  }

  .rail__head {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1.5rem;
    margin-block-end: 1.5rem;
  }

  .rail__controls {
    display: flex;
    gap: 0.5rem;
    flex: none;
  }

  .rail__btn {
    display: grid;
    place-items: center;
    inline-size: 44px;
    block-size: 44px;
    border: 1px solid var(--c-border-2);
    border-radius: 50%;
    color: var(--c-text);
    transition:
      background-color 0.25s,
      opacity 0.25s,
      border-color 0.25s;
  }

  .rail__btn:hover:not(:disabled) {
    background: rgb(255 255 255 / 0.1);
    border-color: rgb(255 255 255 / 0.32);
  }

  .rail__btn:disabled {
    opacity: 0.3;
    cursor: default;
  }

  .rail__track {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: var(--rail-item);
    gap: clamp(0.9rem, 0.6rem + 1vw, 1.5rem);
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: 0;
    padding-block: 0.5rem 1.25rem;
    scrollbar-width: none;
  }

  .rail__track::-webkit-scrollbar {
    display: none;
  }

  .rail__track > :global(*) {
    scroll-snap-align: start;
  }

  .rail__track:focus-visible {
    outline-offset: 6px;
  }

  @media (pointer: coarse) {
    .rail__controls {
      display: none;
    }
  }
</style>
