---
interface Props {
  eyebrow?: string;
  title: string;
  text?: string;
}

const { eyebrow, title, text } = Astro.props;
---

<section class="cta" aria-labelledby="cta-title">
  <div class="container">
    <div class="cta__panel" data-reveal>
      <div class="cta__glow" aria-hidden="true"></div>
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <h2 id="cta-title">{title}</h2>
      {text && <p class="lead">{text}</p>}
      <div class="cta__actions">
        <slot />
      </div>
    </div>
  </div>
</section>

<style>
  .cta {
    padding-block-start: var(--section);
  }

  .cta__panel {
    position: relative;
    isolation: isolate;
    display: grid;
    justify-items: center;
    gap: 1.2rem;
    padding: clamp(3rem, 2rem + 5vw, 6rem) var(--gutter);
    border: 1px solid var(--c-border);
    border-radius: var(--r-xl);
    background: var(--c-bg-2);
    text-align: center;
    overflow: hidden;
  }

  .cta__glow {
    position: absolute;
    inset: -40% -10% auto;
    z-index: -1;
    block-size: 120%;
    background:
      radial-gradient(40% 50% at 30% 50%, rgb(79 140 255 / 0.35), transparent 70%),
      radial-gradient(40% 50% at 70% 50%, rgb(255 92 200 / 0.25), transparent 70%);
    filter: blur(20px);
  }

  h2 {
    max-inline-size: 20ch;
    font-size: var(--fs-3xl);
    font-weight: 800;
    letter-spacing: -0.04em;
  }

  .lead {
    max-inline-size: 36rem;
  }

  .cta__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-block-start: 0.75rem;
  }
</style>
