---
import '@/styles/global.css';
// scripts/subset-font.mjs가 만든 Pretendard 서브셋(사이트에서 쓰는 글자만, 1파일)
import fontUrl from '@/assets/fonts/pretendard-subset.woff2?url';
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import Footer from '@/components/Footer.astro';
import Header from '@/components/Header.astro';
import VideoDialog from '@/components/VideoDialog.astro';
import { site } from '@/data/site';
import { url } from '@/lib/url';
import defaultOg from '@/assets/gen/hero-home.jpg';

interface Props {
  title?: string;
  description?: string;
  /** 공유 미리보기 이미지 — 1200×630으로 잘라서 쓴다 */
  ogImage?: ImageMetadata;
  noindex?: boolean;
}

const { title, description = site.description, ogImage = defaultOg, noindex = false } = Astro.props;
const fullTitle = title ? `${title} | oculus` : site.title;
// 홈은 /oculus/index.html 대신 /oculus/ 로
const canonical = new URL(Astro.url.pathname.replace(/index\.html$/, ''), Astro.site);
const og = await getImage({
  src: ogImage,
  width: 1200,
  height: 630,
  fit: 'cover',
  format: 'jpg',
  quality: 82,
});
const ogUrl = new URL(og.src, Astro.site);
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <link rel="preload" href={fontUrl} as="font" type="font/woff2" crossorigin />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#050507" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" href={url('favicon.svg')} type="image/svg+xml" />
    <link rel="icon" href={url('favicon-32.png')} sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href={url('apple-touch-icon.png')} />
    <link rel="sitemap" href={url('sitemap-index.xml')} />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ko_KR" />
    <meta property="og:site_name" content="oculus" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="generator" content={Astro.generator} />
    <slot name="head" />

    <!-- JS가 켜진 경우에만 스크롤 등장 효과용으로 요소를 숨긴다(첫 페인트 전에 실행). -->
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">
      본문 바로가기
    </a>
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <VideoDialog />
    <script>
      import '@/scripts/site';
    </script>
  </body>
</html>
